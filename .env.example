# ─────────────────────────────────────────────────────────────────────────────
# AI Document Intelligence Platform — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=aidoc_user
POSTGRES_PASSWORD=aidoc_password
POSTGRES_DB=aidoc_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aidoc_user:aidoc_password@localhost:5432/aidoc_db
# Separate migration URL (run under a more-privileged role that has DDL grants)
MIGRATION_DATABASE_URL=postgresql+psycopg2://aidoc_user:aidoc_password@localhost:5432/aidoc_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ─── Background jobs / workers (Phase 4) ─────────────────────────────────────
# Which Arq queue a worker process consumes: arq:queue (ingestion) | arq:low (maintenance)
WORKER_QUEUE_NAME=arq:queue
WORKER_MAX_JOBS=4
JOB_DEFAULT_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_SECONDS=5
JOB_BACKOFF_MAX_SECONDS=300
JOB_STUCK_THRESHOLD_SECONDS=600
RECONCILIATION_SWEEP_INTERVAL_SECONDS=60

# ─── Object Storage (MinIO for dev / S3 or Azure Blob for prod) ──────────────
STORAGE_PROVIDER=minio            # minio | s3 | azure
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_BUCKET_NAME=aidoc-documents
STORAGE_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── JWT / Auth ───────────────────────────────────────────────────────────────
# IMPORTANT: Replace with a strong random secret in production (e.g., openssl rand -hex 64)
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS
# Phase 16: tokens are signed RS256 (asymmetric). REQUIRED in production —
# generate a keypair with:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# then paste the PEM contents (keep \n escapes when embedding in quotes):
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# ROLLOVER ONLY: set to the OLD HS256 secret during key rotation to keep
# verifying (never re-issuing) legacy tokens. REMOVE after the rollover
# window — never set alongside a fresh deployment (Phase 16 plan §4.3).
# JWT_HS256_SECRET=

# ─── AI endpoint rate limiting (Phase 16) ─────────────────────────────────────
AI_RATE_LIMIT_REQUESTS=20         # per-user requests per rolling window on /ask + /chat message endpoints
AI_RATE_LIMIT_WINDOW_SECONDS=60   # rolling window size

# ─── Data retention (Phase 16) ────────────────────────────────────────────────
RETENTION_PURGE_ENABLED=true      # nightly hard-purge of soft-deleted documents
RETENTION_PURGE_DAYS=90           # days after soft-delete before hard-purge
RETENTION_PURGE_BATCH_SIZE=50     # max documents purged per cron run
RETENTION_PURGE_HOUR=3            # hour of day the purge cron fires (0-23)

# ─── AI Providers ─────────────────────────────────────────────────────────────
# OpenAI (embedding + LLM option)
OPENAI_API_KEY=sk-...

# Anthropic (LLM option)
ANTHROPIC_API_KEY=sk-ant-...

# Cohere (reranker option)
COHERE_API_KEY=

# Embedding configuration — MUST be pinned before running the Phase 7 pgvector migration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# LLM configuration (Phase 9)
LLM_PROVIDER=openai               # openai | anthropic | stub (tests/dev, no API calls)
LLM_MODEL=gpt-4o-mini
# Per-attempt timeouts (Backend §51): ~30s generation, ~5s fast
# classification/rewriting calls. 2 attempts, transient-only (4xx never retried).
LLM_GENERATION_TIMEOUT_SECONDS=30
LLM_FAST_TIMEOUT_SECONDS=5
LLM_MAX_RETRIES=2
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
# Grounded answering (Backend §34): low temperature, bounded response size,
# bounded recent history (turns) for follow-up context.
LLM_GENERATION_TEMPERATURE=0.1
LLM_GENERATION_MAX_TOKENS=800
LLM_HISTORY_TURNS=2

# RAG context + query rewriting (Phase 9)
CONTEXT_TOKEN_BUDGET=5000         # SOURCE-block budget (documented 4,000-6,000 band)
REWRITER_TRIGGER_MAX_WORDS=12     # short messages (with prior context) trigger rewriting
REWRITER_SIMILARITY_FLOOR=0.5     # drift guard: below this cosine the raw message is used
RAG_TOP_K_DEFAULT=8               # final sources targeted for context (5-8 band)

# Reranker configuration (Phase 8)
RERANKER_PROVIDER=none            # cohere | stub (tests/dev) | none (unreranked fallback ordering)
RERANKER_MODEL=rerank-v3.5
RERANKER_TIMEOUT_SECONDS=5
RERANKER_MAX_RETRIES=1
# Minimum normalized rerank score [0,1] — below this a candidate is dropped
# even within top-K (makes "no usable evidence" reachable). Initial value in
# the documented 0.3–0.4 band; tuned by Phase 18's evaluation evidence.
RERANK_SCORE_THRESHOLD=0.35

# ─── Citations + source validation (Phase 10) ────────────────────────────────
CITATION_VALIDATION_ENABLED=true  # claim validation stage (Backend §36); false = Phase 9 behaviour
CITATION_QUOTED_SPAN_MAX_CHARS=400  # chunks at/below this size are quoted in full
CITATION_ENTAILMENT_MAX_CHECKS=5  # bounded fast-LLM entailment checks per answer
CITATION_REGENERATION_MAX_RETRIES=1  # citation-emphasis regeneration bound (never unbounded)
CITATION_REGENERATE_UNCITED_RATIO=0.5  # > this fraction uncited => regenerate once

# ─── Conversations + streaming (Phase 11) ────────────────────────────────────
SSE_HEARTBEAT_SECONDS=15          # keep-alive comment cadence on SSE streams (Backend §37)
STREAM_POLL_SECONDS=2             # processing-SSE fallback re-read interval (Redis relay = fast path)
CHAT_STOP_FLAG_TTL_SECONDS=300    # stop-flag TTL — expires when the target already finished

# ─── Hybrid search (Phase 8) ─────────────────────────────────────────────────
SEARCH_MODE_DEFAULT=hybrid        # hybrid | semantic | keyword
HYBRID_VECTOR_TOP_K=50            # candidates from the pgvector ANN branch
HYBRID_KEYWORD_TOP_K=50           # candidates from the full-text (tsvector) branch
RERANK_CANDIDATE_COUNT=30         # fused candidates sent to the reranker (bounds latency)
RRF_K=60                          # Reciprocal Rank Fusion constant

# OCR configuration
OCR_PROVIDER=none                 # none (dev, scanned pages marked OCR-failed) | tesseract | azure_di | textract
OCR_DPI=300                       # rasterization resolution for OCR input
OCR_TIMEOUT_SECONDS=20            # per-page OCR call timeout
OCR_MAX_ATTEMPTS_PER_PAGE=3       # per-page client-level retries before the "OCR failed" marker
OCR_MIN_PAGE_ALNUM_CHARS=25       # pages with fewer alphanumeric chars are classified as needing OCR
EXTRACTION_PAGE_BATCH_SIZE=20     # document_pages rows committed per batch (streamed persistence)
# Tesseract (dev/fallback engine) — path to the binary; omit to use PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANGUAGE=eng
# Azure Document Intelligence (cloud OCR) — required when OCR_PROVIDER=azure_di
# OCR_AZURE_ENDPOINT=
# OCR_AZURE_API_KEY=

# ─── Structure detection + chunking (Phase 6) ────────────────────────────────
# Tokenizer for chunk budgeting — tiktoken encoding matching the default LLM
# family (cl100k_base = OpenAI); falls back to a documented approximation offline
TOKENIZER_ENCODING=cl100k_base
CHUNK_TARGET_MIN_TOKENS=500       # chunks are flushed once content reaches this size
CHUNK_TARGET_MAX_TOKENS=800       # soft upper bound of the target band
CHUNK_HARD_MAX_TOKENS=1000        # absolute maximum, regardless of structure
CHUNK_OVERLAP_RATIO=0.12          # 10–15% overlap between chunks within one section
CHUNKING_BATCH_SIZE=200           # document_chunks rows committed per batch
CHUNK_MAX_HEADING_PATH_DEPTH=10   # JSONB size bound on chunk heading_path metadata

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# ─── Backend Ports ────────────────────────────────────────────────────────────
BACKEND_PORT=8000

# ─── Azure Blob (if STORAGE_PROVIDER=azure) ───────────────────────────────────
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER_NAME=aidoc-documents

# ─── AWS S3 (if STORAGE_PROVIDER=s3) ─────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# S3_BUCKET_NAME=aidoc-documents
