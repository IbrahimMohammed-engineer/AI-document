# ─── Secrets / Environment ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/

# ─── Testing / Coverage ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# ─── Type checking ────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json

# ─── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
# The generic Python `lib/` rule above also matches the frontend's source
# directory — re-include it (it contains committed app code, not build output).
!frontend/src/lib/
!frontend/src/lib/**

# ─── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Docker ───────────────────────────────────────────────────────────────────
# Keep docker-compose.yml committed, ignore local overrides
docker-compose.override.yml

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Alembic ──────────────────────────────────────────────────────────────────
# Keep migrations committed, ignore local Alembic runtime files
# (alembic.ini is committed)

# ─── Uploads / Temp ───────────────────────────────────────────────────────────
uploads/
tmp/
temp/
